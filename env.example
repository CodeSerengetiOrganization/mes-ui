# Kafka (required for EOL submit). Copy to .env and set values.
#
# --- In-cluster (app runs in k3s) ---
# KAFKA_BOOTSTRAP_SERVERS=kafka-kafka-bootstrap.machine-monitoring.svc:9092
#
# --- Local dev (app on laptop; Kafka in k3s) ---
# 1) Port-forward: kubectl port-forward -n machine-monitoring svc/kafka-kafka-bootstrap 9092:9092
# 2) So Kafka metadata hostnames resolve, add to /etc/hosts (or C:\Windows\System32\drivers\etc\hosts):
#    127.0.0.1 kafka-kafka-broker-0.kafka-kafka-brokers.machine-monitoring.svc
# 3) Use:
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
#
# Optional: silence KafkaJS partitioner warning
# KAFKAJS_NO_PARTITIONER_WARNING=1

KAFKA_BOOTSTRAP_SERVERS=

# Optional; default is manufacturing-results-topic
# KAFKA_TOPIC_MANUFACTURING_RESULTS=manufacturing-results-topic
# Legacy fallback (deprecated):
# KAFKA_TOPIC_EOL_RAW_DATA=eol-raw-data
